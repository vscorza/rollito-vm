; ===============================================
; saltarin.retro — ejemplo canónico #3
;   Plataformer con animación, sonido y score.
;   Cubre: GRA, SAL, PIE, ANI, COL coin, FON, SOL, TXT score.
;   Controles: ← → mover, Z saltar.
; ===============================================

JUEGO Saltarin
AUTOR Demo
VERSION 1

SPRITE 1 16x16
6666666666666666
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6555555555555556
6666666666666666

SPRITE 2 8x8
0CCCCCC0
CCCCCCCC
CCCCCCCC
CCCCCCCC
CCCCCCCC
CCCCCCCC
CCCCCCCC
0CCCCCC0

SPRITE 3 8x8
0CCCCCC0
CCCCCCCC
CCCCCCCC
CCCCCCCC
CCC00CCC
CCC00CCC
CCCCCCCC
0CCCCCC0

SPRITE 4 8x8
00AAAA00
0AAAAAA0
AAAAAAAA
AAAAAAAA
AAAAAAAA
AAAAAAAA
0AAAAAA0
00AAAA00

MAPA 0 20x12
00000000000000000000
00000000000000000000
00000000000000000000
00000000000000000000
00000000000000111100
00000000000000000000
00000111110000000000
00000000000000000000
00000000000000000000
00000000000000000000
00000000000000000000
11111111111111111111

SONIDO 0
ONDA PUL
PUL 8
ENV 0,2,8,2
NOTA DO5 3
NOTA SOL5 3
NOTA DO6 3
FIN

SONIDO 1
ONDA SIE
ENV 0,4,0,2
NOTA DO3 6
FIN

SONIDO 2
ONDA SEN
ENV 0,1,12,2
NOTA SOL5 2
NOTA DO6 4
FIN

PROGRAMA
10 EN INICIOJUEGO IR 90
20 EN CUADRO IR 100

; --- INICIOJUEGO ----------------------------
90 FON 0:SOL 0,1
92 PAT 0,2:MOV 0,40,40
94 GRA 0,0,1:LIM 0,0,0,312,200
96 ANI 0,2,3,8
99 RET

; --- CUADRO ---------------------------------
100 D=BTN(1)-BTN(0)
105 VEL 0,D*2,VY(0)
110 SI BTN(4) ENT LLA 200
115 LLA 250
120 LLA 300
125 TXT 8,4,"PUNTOS",7
130 SI PUN=0 ENT 145
135 PAR I=1 A PUN%10
140 REC 64+I*5,4,4,8,11
142 SIG
145 RET

; --- jump ----------------------------------
200 SI PIE(0)=0 ENT 220
205 SAL 0,18:SON 0,0
220 RET

; --- landing -------------------------------
250 G=PIE(0)
255 SI G=1 Y P=0 ENT 270
260 P=G:RET
270 SON 1,1:P=G:RET

; --- coin pickup ----------------------------
300 SI VIS(4)=0 ENT 320
305 SI COL(0,4) ENT LLA 350
310 RET
320 LLA 800
325 RET
350 PUN+=1:SON 2,2
355 LLA 800
360 RET

; --- spawn coin random ----------------------
800 X=ALE(280)
810 MOV 4,X+20,40
820 RET
