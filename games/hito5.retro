PROGRAMA
10 EN CUADRO IR 100

; --- init (sólo cuadro 0) ----------------------
100 SI CUA>0 ENT 130
105 FON 0
110 SOL 0,1
115 PAT 0,2
120 MOV 0,40,40
125 GRA 0,0,1
128 LIM 0,0,0,312,200

; --- input + lógica por cuadro -----------------
130 D=BTN(1)-BTN(0)
135 VEL 0,D*2,VY(0)
140 SI BTN(4) ENT SAL 0,18
145 RET
