; --- Sonidos ----------------------------------

SONIDO 0
ONDA PUL
PUL 8
ENV 0,2,8,2
NOTA DO5 3
NOTA SOL5 3
NOTA DO6 3
FIN

SONIDO 1
ONDA SEN
ENV 0,1,12,2
NOTA SOL5 2
NOTA DO6 4
FIN

SONIDO 2
ONDA TRI
ENV 0,2,12,3
NOTA DO5 3
NOTA MI5 3
NOTA SOL5 3
NOTA DO6 6
FIN

SONIDO 3
ONDA SIE
ENV 0,4,0,4
NOTA DO3 8
NOTA FA2 12
FIN

PROGRAMA
10 EN INICIOJUEGO IR 90
20 EN INICIONIVEL IR 200
30 EN CUADRO IR 100

; --- INICIOJUEGO -----------------------------
90 PAT 0,2:ANI 0,2,3,8
92 LIM 0,0,0,312,200
94 VID=3
96 RET

; --- INICIONIVEL: layout por NIV --------------
200 SI NIV=0 ENT FON 0
205 SI NIV=1 ENT FON 1
210 SOL NIV,1
215 GRA 0,NIV,1
220 MOV 0,16,40
225 PAT 4,4
228 SI NIV=0 ENT MOV 4,144,72
232 SI NIV=1 ENT MOV 4,200,40
240 PAT 5,5
245 MOV 5,288,144
250 SI NIV=0 ENT LLA 800
255 RET

; --- CUADRO ----------------------------------
100 SI Z<>0 ENT 160
105 D=BTN(1)-BTN(0)
110 VEL 0,D*2,VY(0)
115 SI BTN(4) ENT LLA 300
120 LLA 350
125 LLA 400
130 LLA 450
135 SI NIV=0 ENT LLA 700
140 LLA 500
145 RET

; --- jump ------------------------------------
300 SI PIE(0)=0 ENT 320
305 SAL 0,18:SON 0,0
320 RET

; --- coin pickup ------------------------------
350 SI VIS(4)=0 ENT 370
355 SI COL(0,4) ENT LLA 360
370 RET
360 OCU 4,1:PUN+=1:SON 1,1
365 RET

; --- meta (flag) ------------------------------
400 SI COL(0,5) ENT LLA 410
405 RET
410 SI NIV=1 ENT 430
415 SON 2,2:CARNIV NIV+1
420 RET
430 SON 2,2:Z=1
435 RET

; --- caída fuera de pantalla / muerte ---------
450 SI Y(0)>192 ENT LLA 460
455 RET
460 SON 3,3:VID-=1
462 SI VID<=0 ENT 480
464 CARNIV NIV
466 RET
480 Z=2:RET

; --- enemy: rebote en bordes + colisión ------
700 SI X(6)<24 ENT INV 6,X
705 SI X(6)>240 ENT INV 6,X
710 SI COL(0,6) ENT LLA 460
715 RET

; --- enemy spawn (sólo en NIV=0) -------------
800 PAT 6,6:MOV 6,80,168
810 VEL 6,1,0
820 RET

; --- HUD: P/V/NIV en la fila superior --------
500 TXT 8,4,"P",7
505 SI PUN=0 ENT 520
510 PAR I=1 A PUN%10
515 REC 24+I*5,4,4,8,11
518 SIG
520 TXT 80,4,"V",7
525 SI VID<=0 ENT 545
530 PAR I=1 A VID
535 REC 96+I*8,4,6,8,8
540 SIG
545 TXT 160,4,"NIV",7
550 SI NIV=0 ENT TXT 192,4,"1"
555 SI NIV=1 ENT TXT 192,4,"2"
560 RET

; --- overlay de fin de juego -----------------
160 LLA 500
165 SI Z=1 ENT 170 SINO 180
170 TXT 96,80,"GANASTE!",10
175 RET
180 TXT 96,80,"GAME OVER",8
185 RET
