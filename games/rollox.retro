PROGRAMA

10 EN INICIOJUEGO IR 100
20 EN CUADRO IR 200

; --- INICIOJUEGO -----------------------------
;   S = estado (0=title, 1=play, 2=over)
100 S=0
102 PUN=0:NIV=0:K=0:L=0:VID=5
103 PAL 0
105 LLA 120
110 RET

; --- 120: init partida (vars) ---------------
120 A=0:B=160:C=0:D=0:E=1
122 G=0:F=0:U=0:H=0
123 LLA 140
130 RET

; --- 140: reset bullets + enemies ------------
;   Llamada al iniciar y al reiniciar tras
;   game over para que no quede estado viejo.
140 PAR I=0 A 3
142 M5(I)=0:M6(I)=0:M7(I)=0
144 M3(20+I)=0
146 SIG
148 PAR I=0 A 7
150 M4(I)=0:M4(16+I)=0
152 M7(16+I)=0:M2(16+I)=0
154 M0(16+I)=0:M1(16+I)=0
156 M5(16+I)=0:M6(16+I)=0
158 SIG
160 RET


; --- CUADRO: dispatcher por estado -----------
;   S=1 → IR 215 (gameplay).
;   S=0/2 → render title/over y RET.
200 SI S=1 ENT IR 215
205 SI S=0 ENT LLA 700
210 SI S=2 ENT LLA 800
212 RET
215 LLA 300
220 LLA 350
222 LLA 380
223 LLA 420
224 LLA 460
226 LLA 900
2265 LLA 870
227 LLA 930
228 LLA 1130
229 LLA 1170
231 LLA 600
232 RET

; --- 300: input ------------------------------
;   ojo: SI cond ENT a:b NO encadena b al cond.
;   Por eso cada acción va en su propia SI line.
300 SI BTN(0) ENT D=1
302 SI BTN(0) ENT A-=2
305 SI BTN(1) ENT D=0
307 SI BTN(1) ENT A+=2
310 SI BTN(4) Y E=1 ENT C=-7
311 SI BTN(4) Y E=1 ENT SON 1,1
315 SI A<0 ENT A+=2048
320 SI A>=2048 ENT A-=2048
325 RET

; --- 350: physics manual ---------------------
;   R guarda B antes de actualizar (para detectar
;   transición prev_bot → new_bot al landing).
348 R=B
350 B+=C
355 SI CUA%2=0 ENT C+=1
360 SI C>8 ENT C=8
365 SI B<160 ENT E=0
370 SI B>=160 ENT B=160
372 SI B>=160 ENT C=0
374 SI B>=160 ENT E=1
376 RET

; --- 420: shoot ------------------------------
;   Bullets son screen-relative.
;   M5(i)=screen_x, M6(i)=y, M7(i)=vx (0=libre).
;   M3(20+i)=vy (BTN(2) hace shoot vertical).
;   F = cooldown frames. U = next slot rotativo.
420 SI F>0 ENT F-=1
422 SI BTN(5)=0 ENT IR 446
424 SI F>0 ENT IR 446
426 M5(U)=96
428 SI D=1 ENT M5(U)=64
430 M6(U)=B
432 M7(U)=4
434 SI D=1 ENT M7(U)=-4
435 M3(20+U)=0
436 SI BTN(2) ENT M3(20+U)=-5
437 SI BTN(2) ENT M7(U)=0
438 SI BTN(2) ENT M5(U)=80
439 U=(U+1)%4
440 F=8
442 SON 0,0
446 RET

; --- 460: bullet update (no render) ----------
;   Bullet "vivo" = M7(I)<>0 OR M3(20+I)<>0.
460 PAR I=0 A 3
461 Q=M7(I)+M3(20+I)
462 SI Q=0 ENT IR 478
464 M5(I)+=M7(I)
465 M6(I)+=M3(20+I)
466 SI M5(I)<-8 ENT M7(I)=0
467 SI M5(I)>=328 ENT M7(I)=0
468 SI M6(I)<-8 ENT M3(20+I)=0
469 SI M6(I)>=208 ENT M3(20+I)=0
478 SIG
480 RET

; --- 380: colisión player ↔ map 2 ------------
;   feet en world_x=A+80, world_y=B+16. Mira los
;   2 tiles bajo los pies; si alguno es no-cero
;   y el player viene cayendo, snap al tile top.
380 SI C<=0 ENT IR 408
381 W=(A+80)%2048
382 P=W/16
383 R=(B+16)/16
384 V=(P+1)%128
385 Q=TIL(2,P,R)+TIL(2,V,R)
386 SI Q=0 ENT IR 408
388 B=R*16-16
389 C=0
390 E=1
408 RET

; --- 600: render -----------------------------
600 BOR 1
602 SI ALE(180)=0 ENT G=3
603 SI G=3 ENT SON 4,3
604 SI G>0 ENT BOR 7
606 SI G>0 ENT G-=1
608 LLA 670
609 LLA 680
610 LLA 690
611 LLA 1050
6115 LLA 1090
612 LLA 1100
613 LLA 660
6135 LLA 695
614 LLA 1200
615 RET

; --- 670: parallax-far render ----------------
;   Map 0 (320x64), scroll A/4, alpha 2.
670 T=-(A/4)%320
672 MAP 0,T,16,2
673 MAP 0,T+320,16,2
674 RET

; --- 680: parallax-near render ---------------
;   Map 1 (320x96), scroll A/2, alpha 4.
680 T=-(A/2)%320
682 MAP 1,T,8,4
683 MAP 1,T+320,8,4
684 RET

; --- 690: level render -----------------------
;   Map 2 (2048x192), scroll A, opaco.
690 T=-A
692 MAP 2,T,0
693 MAP 2,T+2048,0
694 RET

; --- 695: foreground render ------------------
;   Map 3 (320x192), scroll 2A, alpha 4.
695 T=-(A*2)%320
696 MAP 3,T,0,4
697 MAP 3,T+320,0,4
698 RET

; --- 660: player render ---------------------
;   E=0 (jump) → sprite 26.
;   E=1: si BTN(0) o BTN(1), animar walk; si no, idle.
660 SI E=1 ENT IR 664
662 SPR 26,80,B,D
663 RET
664 Q=0
666 SI BTN(0) ENT Q=1
667 SI BTN(1) ENT Q=1
668 SI Q=0 ENT P=24
670 SI Q=1 ENT P=24+CUA/6%2
672 SPR P,80,B,D
674 RET

; --- 700: TITLE ------------------------------
700 BOR 9
705 LLA 750
710 TXT 88,140,"PRESIONA TECLA"
720 SI BTN(0) ENT S=1
722 SI BTN(1) ENT S=1
724 SI BTN(4) ENT S=1
726 SI BTN(5) ENT S=1
728 SI BTN(6) ENT S=1
730 SI TEC(32) ENT S=1
740 RET

; --- 750: dibuja ROLLOX ----------------------
750 SPRR 20,64,72,0,192
755 SPRR 21,96,72,0,192
760 SPRR 22,128,72,0,192
765 SPRR 22,160,72,0,192
770 SPRR 21,192,72,0,192
775 SPRR 23,224,72,0,192
780 RET

; --- 800: GAME OVER + restart ----------------
;   L = wait counter (≥30 antes de aceptar input).
800 BOR 0
802 L+=1
805 TXT 8,8,"PUN",7
806 LLA 1240
810 TXT 112,80,"GAME OVER"
812 SI L<30 ENT IR 824
814 TXT 80,140,"PRESIONA TECLA"
816 SI BTN(0) ENT IR 830
818 SI BTN(1) ENT IR 830
820 SI BTN(4) ENT IR 830
822 SI BTN(5) ENT IR 830
824 RET

; --- 830: restart full ----------------------
830 LLA 100
834 RET

; --- 870: telegraph tick ---------------------
;   Decrementa M7(16+I); en 0 activa enemigo
;   (M4(I)=tipo, hp=1+NIV/2, vx=1).
870 PAR I=0 A 7
872 SI M7(16+I)=0 ENT IR 884
874 M7(16+I)-=1
876 SI M7(16+I)>0 ENT IR 884
878 M4(I)=M4(16+I)
879 M5(16+I)=1+NIV/2
880 M2(16+I)=1
882 M4(16+I)=0
884 SIG
886 RET

; --- 900: enemy spawn ------------------------
;   Telegrafia 2s con star antes de activar.
;   M4(16+I)=tipo pendiente, M7(16+I)=ttl.
;   Spawnea fuera de 1/2 pantalla del player
;   (player en A+80 → world_x en [A+240,A+319]).
900 H+=1
902 SI H<90-NIV*5 ENT IR 925
904 H=0
906 V=0
908 PAR I=0 A 7
910 SI V=1 ENT IR 924
912 SI M4(I)<>0 ENT IR 924
913 SI M4(16+I)<>0 ENT IR 924
914 T=ALE(3)+1
915 M0(16+I)=A+240+ALE(80)
916 M4(16+I)=T
917 M6(16+I)=0
918 M7(16+I)=120
920 SI T=2 ENT M1(16+I)=144
921 SI T<>2 ENT M1(16+I)=60
923 V=1
924 SIG
925 RET

; --- 930: enemy AI ---------------------------
930 PAR I=0 A 7
932 SI M4(I)=0 ENT IR 956
934 SI M4(I)=1 ENT LLA 960
936 SI M4(I)=2 ENT LLA 980
938 SI M4(I)=3 ENT LLA 1000
940 SI M5(16+I)<=0 ENT M4(I)=0
956 SIG
958 RET

; --- 960: bat AI -----------------------------
;   Vuela horizontal, y cubre toda la vertical
;   (SEN/16 = ±62 → y in [18, 142]).
960 M0(16+I)+=M2(16+I)
962 M1(16+I)=80+SEN(CUA*4+I)/16
964 RET

; --- 980: wolf AI ----------------------------
;   Camina hacia el player.
;   V de temp (no se accede entre llamadas).
980 W=A+80
981 V=M2(16+I)
982 SI M0(16+I)<W ENT V=1
984 SI M0(16+I)>W ENT V=-1
986 M2(16+I)=V
987 M0(16+I)+=V
988 RET

; --- 1000: alien AI --------------------------
;   Sigue al player horizontal + teleport;
;   y oscila tipo bat pero más lento.
1000 M6(16+I)+=1
1001 W=M6(16+I)
1002 SI W>=80 ENT LLA 1030
1003 W=A+80
1004 V=M2(16+I)
1005 SI M0(16+I)<W ENT V=1
1006 SI M0(16+I)>W ENT V=-1
1007 M2(16+I)=V
1008 M0(16+I)+=V
1009 M1(16+I)=80+SEN(CUA*2+I)/16
1010 RET

; --- 1030: alien teleport --------------------
1030 M0(16+I)=A+ALE(320)
1032 M6(16+I)=0
1034 RET

; --- 1050: enemy render ----------------------
1050 PAR I=0 A 7
1052 SI M4(I)=0 ENT IR 1078
1054 T=(M0(16+I)-A+2048)%2048
1056 SI T>=320 ENT IR 1078
1058 N=0
1060 SI M2(16+I)<0 ENT N=1
1061 Y=M1(16+I)
1062 SI M4(I)=1 ENT LLA 1085
1064 SI M4(I)=2 ENT SPR 16,T,Y,N
1066 SI M4(I)=3 ENT SPR 18,T,Y,N
1078 SIG
1080 RET

1085 P=28+CUA/8%2
1087 SPR P,T,Y,N
1089 RET

; --- 1090: telegraph render ------------------
;   Star wiggling en pos del próximo enemigo.
1090 PAR I=0 A 7
1091 SI M7(16+I)=0 ENT IR 1098
1092 T=(M0(16+I)-A+2048)%2048
1093 SI T>=320 ENT IR 1098
1094 V=SEN(CUA*8+I*30)/256
1095 W=SEN(CUA*8+I*30+90)/256
1096 Y=M1(16+I)+W
1097 SPR 13,T+V,Y
1098 SIG
1099 RET

; --- 1100: bullet render ---------------------
1100 PAR I=0 A 3
1101 Q=M7(I)+M3(20+I)
1102 SI Q=0 ENT IR 1108
1104 SPR 31,M5(I),M6(I)
1108 SIG
1110 RET

; --- 1130: collisions bullet ↔ enemy ---------
1130 PAR I=0 A 7
1132 SI M4(I)=0 ENT IR 1166
1134 W=(M0(16+I)-A+2048)%2048
1136 SI W>=320 ENT IR 1166
1138 Y=M1(16+I)
1140 PAR J=0 A 3
1141 Q=M7(J)+M3(20+J)
1142 SI Q=0 ENT IR 1162
1144 SI M5(J)+16<W ENT IR 1162
1146 SI M5(J)>W+16 ENT IR 1162
1148 SI M6(J)+16<Y ENT IR 1162
1150 SI M6(J)>Y+16 ENT IR 1162
1152 M5(16+I)-=1
1153 M7(J)=0
1156 M3(20+J)=0
1158 SON 2,2
1154 SI M5(16+I)<=0 ENT LLA 1300
1162 SIG
1166 SIG
1168 RET

; --- 1170: player vs enemy -------------------
1170 PAR I=0 A 7
1172 SI M4(I)=0 ENT IR 1190
1174 W=(M0(16+I)-A+2048)%2048
1176 SI W>=320 ENT IR 1190
1178 SI W+16<80 ENT IR 1190
1180 SI W>96 ENT IR 1190
1181 Y=M1(16+I)
1182 SI Y+16<B ENT IR 1190
1184 SI Y>B+16 ENT IR 1190
1186 VID-=1
1187 SON 2,3
1188 M4(I)=0
1189 SI VID<=0 ENT S=2
11895 SI VID<=0 ENT L=0
1190 SIG
1192 RET

; --- 1200: HUD -------------------------------
1200 TXT 8,8,"PUN",7
1205 LLA 1240
1206 LLA 1210
1207 LLA 230
1208 RET

; --- 1210: HUD vidas (5 cuadros rojos top-rt)
1210 PAR I=0 A 4
1211 X=256+I*12
1212 SI I<VID ENT REC X,4,8,8,8
1214 SIG
1216 RET

; --- 230: reflexiones cada 5s ----------------
;   Z = índice 0..4 que rota c/300 cuadros.
;   Texto al centro (y=96) y al pie (y=184).
230 X=CUA/100%5
231 SI X=0 ENT Z=ALE(5)
232 SI Z=0 ENT LLA 240
233 SI Z=1 ENT LLA 250
234 SI Z=2 ENT LLA 260
235 SI Z=3 ENT LLA 270
236 SI Z=4 ENT LLA 280
237 RET

240 TXT 120,184,"MAMAAAA"
241 RET

250 TXT 120,184,"UHHHHHH"
251 RET

260 TXT 120,184,"AIKILAMAN"
261 RET

270 TXT 120,184,"AAAAAAA"
271 RET

280 TXT 120,184,"CARRION"
281 RET

; --- 1240: render PUN como 4 dígitos ---------
;   M2(28..31) = digit slots (libres).
1240 W=PUN
1242 M2(28)=W/1000
1244 W=W%1000
1246 M2(29)=W/100
1248 W=W%100
1250 M2(30)=W/10
1252 M2(31)=W%10
1254 X=32
1256 PAR I=0 A 3
1257 V=M2(28+I)
1258 SI V=0 ENT TXT X,8,"0",7
1260 SI V=1 ENT TXT X,8,"1",7
1262 SI V=2 ENT TXT X,8,"2",7
1264 SI V=3 ENT TXT X,8,"3",7
1266 SI V=4 ENT TXT X,8,"4",7
1268 SI V=5 ENT TXT X,8,"5",7
1270 SI V=6 ENT TXT X,8,"6",7
1272 SI V=7 ENT TXT X,8,"7",7
1274 SI V=8 ENT TXT X,8,"8",7
1276 SI V=9 ENT TXT X,8,"9",7
1280 X+=8
1282 SIG
1284 RET

; --- 1300: enemy died (called from coll) -----
1300 M4(I)=0
1302 PUN+=1
1304 K+=1
1305 SON 3,3
1306 SI K>=10 ENT LLA 1320
1308 RET

; --- 1320: level up --------------------------
;   NIV+=1, K=0, palette swap.
1320 NIV+=1
1322 K=0
1324 PAL NIV%3
1325 SON 5,3
1328 RET
