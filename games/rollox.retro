; --- Mapas de las 4 capas --------------------
;   0 = parallax-far (siluetas lejanas, A/4)
;   1 = parallax-near (rocas / estalactitas, A/2)
;   2 = level (piso + plataformas, world A)
;   3 = foreground (vegetación cercana, A*2)

